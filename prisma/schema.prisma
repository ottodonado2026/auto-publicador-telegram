datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  CLIENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum TelegramAccountStatus {
  DISCONNECTED
  CONNECTING
  WAITING_CODE
  WAITING_PASSWORD
  CONNECTED
  BANNED
  ERROR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum MessageLogStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String        @id @default(uuid())
  botCode       String?       @unique
  email         String?       @unique
  phoneNumber   String?       @unique
  storeName     String?
  name          String?
  passwordHash  String
  role          Role          @default(CLIENT)
  isActive      Boolean       @default(true)
  walletBalance Decimal       @default(0.00) @db.Decimal(10, 2)
  otpCode       String?
  otpExpiresAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscription       Subscription?
  telegramAccounts   TelegramAccount[]
  campaigns          Campaign[]
  auditLogs          AuditLog[]
  walletTransactions WalletTransaction[]

  // Sistema de Referidos & Bonos
  referredById        String?
  referredBy          User?           @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]          @relation("UserReferrals")
  referralBonuses     ReferralBonus[] @relation("ReferrerBonuses")
  receivedBonuses     ReferralBonus[] @relation("ReferredBonuses")
  pendingBonusBalance Decimal         @default(0.00) @db.Decimal(10, 2)

  @@map("users")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  type        String   // "CREDIT" (Recarga) | "DEBIT" (Compra de Plan)
  description String
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        SubscriptionStatus @default(TRIAL)
  dailyRate     Decimal            @default(1.25) @db.Decimal(10, 2)
  startsAt      DateTime           @default(now())
  expiresAt     DateTime           // Fecha exacta y estricta de corte
  maxAccounts   Int                @default(1)
  maxCampaigns  Int                @default(2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("USD")
  daysAdded      Int          @default(1)
  reference      String?
  confirmedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@map("payments")
}

model TelegramAccount {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber     String
  sessionString   String?               // Sesión MTProto GramJS (cifrada)
  telegramUserId  String?
  firstName       String?
  username        String?
  status          TelegramAccountStatus @default(DISCONNECTED)
  isSystemAccount Boolean               @default(false) // Indica si pertenece a la flota/granja del SuperAdmin
  phoneCodeHash   String?               // Hash temporal para verificación MTProto
  lastError       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  campaigns Campaign[]
  logs      MessageLog[]

  @@map("telegram_accounts")
}

model MembershipPlan {
  id               String   @id @default(uuid())
  name             String   // Ej: "Pase Express (1 Día)", "Plan Semanal (7 Días)"
  days             Int      // 1, 7, 15, 30
  priceUSD         Decimal  @db.Decimal(10, 2)
  dailyEquivalent  Decimal  @db.Decimal(10, 2)
  description      String?
  maxGroups        Int      @default(15)     // Límite de grupos destino
  maxDailyPosts    Int      @default(50)     // Límite de mensajes/día
  delayBetweenMsgs Int      @default(60)     // Segundos entre envíos (antibaneo)
  cooldownMinutes  Int      @default(120)    // Minutos de descanso entre rondas de difusión
  allowCustomBot   Boolean  @default(true)   // Conectar su propio Telegram
  allowFarmBot     Boolean  @default(false)  // Usar la flota del sistema por links
  features         Json?                     // Array de strings con viñetas de beneficios
  isActive         Boolean  @default(true)
  isPopular        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("membership_plans")
}

model Campaign {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramAccountId String
  telegramAccount   TelegramAccount @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  name              String
  messageContent    String          @db.Text
  mediaUrl          String?
  intervalMinutes   Int             @default(30)
  targetGroupIds    Json            // Array de group IDs o chat links donde publicar
  status            CampaignStatus  @default(PAUSED)
  lastRunAt         DateTime?
  nextRunAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  logs MessageLog[]

  @@map("campaigns")
}

model MessageLog {
  id                String           @id @default(uuid())
  campaignId        String
  campaign          Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  telegramAccountId String
  telegramAccount   TelegramAccount  @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  targetGroupId     String
  targetGroupName   String?
  status            MessageLogStatus @default(PENDING)
  errorMessage      String?          @db.Text
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  @@map("message_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model PendingAuthSession {
  id            String   @id @default(uuid())
  phoneNumber   String   @unique
  phoneCodeHash String
  sessionString String   // Sesión MTProto GramJS persistente para Serverless
  dataJson      String?  // Datos de registro o login en JSON
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@map("pending_auth_sessions")
}

model LandingVisit {
  id          String   @id @default(uuid())
  visitorHash String?
  lang        String?  @default("es")
  currency    String?  @default("USD")
  referrer    String?
  createdAt   DateTime @default(now())

  @@map("landing_visits")
}

model ReferralBonus {
  id              String    @id @default(uuid())
  referrerId      String
  referrer        User      @relation("ReferrerBonuses", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId  String
  referredUser    User      @relation("ReferredBonuses", fields: [referredUserId], references: [id], onDelete: Cascade)
  amountUSD       Decimal   @db.Decimal(10, 2)
  sourceTxAmount  Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDING") // "PENDING" (en espera del ciclo semanal) | "RELEASED" (liberado a Wallet)
  releaseDate     DateTime  // Fecha exacta de liberación (7 días tras la recarga)
  releasedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@map("referral_bonuses")
}

model ReferralConfig {
  id               String   @id @default("default")
  bronzeMinRefs    Int      @default(1)
  bronzePercent    Float    @default(10.0)
  silverMinRefs    Int      @default(5)
  silverPercent    Float    @default(15.0)
  goldMinRefs      Int      @default(15)
  goldPercent      Float    @default(20.0)
  retentionDays    Int      @default(7)
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("referral_configs")
}


